# State machine with choice, history, composite state, and terminate pseudostate.

PaymentProcessing[state-machine]:
  - layout:
      direction: TB
      rank_gap: 140
      node_gap: 72
  - initial --> Processing
  - Processing[composite-state]:
      - layout:
          direction: LR
          rank_gap: 120
          node_gap: 56
      - initial --> Authorizing
      - Authorizing[state]
      - RetryChoice[choice]
      - PreviousAttempt[history]:
          type: shallow
      - Authorized[state]
      - Failed[state]
      - initial --> Authorizing
      - Authorizing --> Authorized:
          trigger: "approved"
      - Authorizing --> RetryChoice:
          trigger: "declined"
      - RetryChoice --> PreviousAttempt:
          guard: "retry count < 3"
      - RetryChoice --> Failed:
          guard: "retry count >= 3"
  - Processing --> Completed:
      trigger: "authorized"
  - Abort[terminate]
  - Processing --> Abort:
      trigger: "fraud detected"
  - Completed[state]
  - Completed --> final
