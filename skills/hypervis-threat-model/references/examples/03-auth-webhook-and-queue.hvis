# Threat model combining auth, webhook callback, message queue, and third-party boundary.

WebhookThreats[threat-model]:
  - Internet[trust-boundary]:
      - PartnerWebhook[external-entity]:
          description: "Third-party webhook sender"
      - UserBrowser[external-entity]:
          description: "Signed-in customer browser"
  - EdgeTier[trust-boundary]:
      - Waf[process]:
          description: "Filters public traffic"
      - AuthProxy[process]:
          description: "Validates OIDC session"
  - AppTier[trust-boundary]:
      - WebhookApi[process]:
          controls: ["signature verification", "idempotency key"]
          threats:
            - category: tampering
              severity: high
              status: open
              title: "Replayed webhook payloads"
              description: "An attacker could replay captured signed requests before expiry."
            - category: elevation-of-privilege
              severity: medium
              status: accepted
              title: "Residual trust in partner identity"
              description: "A compromised partner account could publish malicious events."
              rationale: "Accepted with contractual monitoring, key rotation, and provider audit rights."
      - EventQueue[data-store]:
          encrypted: true
  - UserBrowser --> AuthProxy:
      label: "OIDC login callback"
      encrypted: true
      authenticated: true
  - PartnerWebhook --> Waf:
      label: "HTTPS signed webhook"
      encrypted: true
      authenticated: false
      threats:
        - category: spoofing
          severity: medium
          status: mitigated
          title: "Spoofed webhook origin"
          description: "Caller may impersonate the partner."
          mitigation: "HMAC signatures and static partner allowlists."
  - Waf --> WebhookApi:
      label: "Forwards verified request"
      encrypted: true
  - AuthProxy --> WebhookApi:
      label: "Injects identity headers"
      encrypted: true
      authenticated: true
  - WebhookApi --> EventQueue:
      label: "Publishes normalized event"
      encrypted: true
