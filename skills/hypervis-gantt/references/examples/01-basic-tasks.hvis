# Basic Gantt chart with tasks, dates, progress, depends_on, and milestone.

ReleasePlan[gantt]:
  - timeline:
      scale: day
      today: 2026-07-10
  - DesignApi[task]:
      start: 2026-07-01
      end: 2026-07-05
      progress: 1
  - BuildService[task]:
      start: 2026-07-06
      end: 2026-07-14
      progress: 0.4
      depends_on:
        - DesignApi
  - Launch[milestone]:
      date: 2026-07-21
      depends_on:
        - BuildService
